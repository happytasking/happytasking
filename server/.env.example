PORT=5000
CLIENT_URL=http://localhost:3000
# Optional extra browser origins allowed to call the API directly (comma separated)
ALLOWED_ORIGINS=
DATABASE_URL=postgresql://happytasking:happytasking@localhost:5432/happy_tasking?schema=public
JWT_SECRET=happy-tasking-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional. Only used by `npm run db:seed` on a local database.
# If set (16+ characters, not the public demo password), seed creates
# moderator@happytasking.com with this password. Leave unset otherwise.
# Never set this in production. Never commit a real value.
# SEED_MODERATOR_PASSWORD=
