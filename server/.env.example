PORT=5000
CLIENT_URL=http://localhost:3000
# Optional extra browser origins allowed to call the API directly (comma separated)
ALLOWED_ORIGINS=
DATABASE_URL=postgresql://happytasking:happytasking@localhost:5432/happy_tasking?schema=public
JWT_SECRET=happy-tasking-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional. Only used by `npm run db:seed` on a local database.
# If set (16+ characters, not the public demo password), seed creates
# moderator@happytasking.com with this password. Leave unset otherwise.
# Never set this in production. Never commit a real value.
# SEED_MODERATOR_PASSWORD=

# Sprint 4.6 opportunity ingestion (not secrets)
AITRAINING_JOBS_ENABLED=true
AITRAINING_JOBS_SOURCE_MODE=live
AITRAINING_JOBS_SYNC_INTERVAL=60
AITRAINING_JOBS_BASE_URL=https://aitraining.jobs
# Next.js public fetchRoles server-action id; adapter rediscovers it if stale.
# AITRAINING_JOBS_FETCH_ROLES_ACTION=
OPPORTUNITY_SYNC_ENABLED=true
OPPORTUNITY_SYNC_STALE_AFTER_HOURS=26
OPPORTUNITY_SYNC_CLOSE_AFTER_HOURS=72
OPPORTUNITY_SYNC_LOCK_TTL_MINUTES=50
OPPORTUNITY_SYNC_REQUEST_TIMEOUT_MS=20000
OPPORTUNITY_SYNC_SOURCE_TIMEOUT_MS=180000
OPPORTUNITY_SYNC_RUN_TIMEOUT_MS=2400000
OPPORTUNITY_SYNC_USER_AGENT=HappyTaskingOpportunitySync/1.0 (+https://happytasking.com)
